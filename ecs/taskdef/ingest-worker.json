{
  "family": "devin-remediation-ingest-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::000000000000:role/devin-remediation-task-execution",
  "taskRoleArn": "arn:aws:iam::000000000000:role/devin-remediation-ingest-worker-task",
  "containerDefinitions": [
    {
      "name": "ingest-worker",
      "image": "000000000000.dkr.ecr.us-east-1.amazonaws.com/devin-remediation-service:REPLACE_WITH_IMMUTABLE_TAG",
      "essential": true,
      "command": [
        "uv",
        "run",
        "celery",
        "-A",
        "app.celery_app:celery_app",
        "worker",
        "-Q",
        "ingest",
        "-n",
        "ingest@%h",
        "--loglevel=info",
        "--concurrency=2"
      ],
      "environment": [
        {
          "name": "CELERY_BROKER_URL",
          "value": "redis://REPLACE_WITH_ELASTICACHE_ENDPOINT:6379/0"
        },
        {
          "name": "CELERY_RESULT_BACKEND",
          "value": "redis://REPLACE_WITH_ELASTICACHE_ENDPOINT:6379/1"
        },
        {
          "name": "CELERY_TASK_SOFT_TIME_LIMIT",
          "value": "900"
        },
        {
          "name": "CELERY_TASK_TIME_LIMIT",
          "value": "1200"
        },
        {
          "name": "GITHUB_REPO",
          "value": "your-org/target-repo"
        },
        {
          "name": "HTTP_CONNECT_TIMEOUT",
          "value": "5"
        },
        {
          "name": "HTTP_MAX_ATTEMPTS",
          "value": "4"
        },
        {
          "name": "HTTP_READ_TIMEOUT",
          "value": "30"
        },
        {
          "name": "LOG_FORMAT",
          "value": "json"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "ORCHESTRATOR",
          "value": "celery"
        },
        {
          "name": "SCAN_INTERVAL_MINUTES",
          "value": "5"
        },
        {
          "name": "SEMGREP_CHECKOUT_DIR",
          "value": "/tmp/remediation-checkout"
        },
        {
          "name": "SEMGREP_CONFIG",
          "value": "p/default"
        },
        {
          "name": "SEMGREP_MAX_FINDINGS",
          "value": "0"
        },
        {
          "name": "SEMGREP_SCAN_INTERVAL_MINUTES",
          "value": "60"
        },
        {
          "name": "SERVICE_NAME",
          "value": "remediation-ingest-worker"
        },
        {
          "name": "UV_NO_SYNC",
          "value": "1"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:000000000000:secret:devin-remediation/database-url"
        },
        {
          "name": "GITHUB_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:000000000000:secret:devin-remediation/github-token"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "uv run celery -A app.celery_app:celery_app inspect ping -d ingest@$HOSTNAME --timeout 10 || exit 1"
        ],
        "interval": 30,
        "timeout": 20,
        "retries": 3,
        "startPeriod": 60
      },
      "stopTimeout": 120,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/devin-remediation/ingest-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ingest-worker",
          "awslogs-create-group": "true"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "semgrep-checkout",
          "containerPath": "/tmp/remediation-checkout",
          "readOnly": false
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "semgrep-checkout"
    }
  ],
  "ephemeralStorage": {
    "sizeInGiB": 30
  },
  "tags": [
    {
      "key": "app",
      "value": "devin-remediation"
    },
    {
      "key": "component",
      "value": "ingest-worker"
    }
  ]
}
