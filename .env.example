GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_org/target_repo
DEVIN_API_KEY=your_devin_api_key_here
DEVIN_ORG_ID=your_devin_org_id_here
SCAN_INTERVAL_MINUTES=5
# PostgreSQL connection string (matches the postgres service in docker-compose.yml).
# Leave unset to fall back to a local SQLite file (sqlite:///./remediation.db).
DATABASE_URL=postgresql+psycopg://remediation:remediation@postgres:5432/remediation
