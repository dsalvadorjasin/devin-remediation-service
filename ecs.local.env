# ECS-local overrides: what the managed-service / Service Connect endpoints
# resolve to when the stack runs under compose.ecs.local.yml.
#
# The *.ecs.local names are Service Connect / Cloud Map style names emulated
# with compose network aliases (namespace "ecs.local"); in AWS the same names
# come from the Cloud Map namespace attached to the cluster.
#
# How these are consumed (see docs/ecs-local.md):
#   - Keys a task definition declares in `environment` are overridden with the
#     value below when scripts/ecs_local_env.py renders the per-task env file.
#   - Keys a task definition declares in `secrets` are NEVER taken from here;
#     they are fetched from Secrets Manager (LocalStack). DATABASE_URL below is
#     what scripts/localstack-init.sh seeds into the devin-remediation/database-url
#     secret, exactly as an RDS connection string would be stored in AWS.
#   - ${NAME} is expanded from .env.
GITHUB_REPO=${GITHUB_REPO}
DATABASE_URL=postgresql+psycopg://remediation:${POSTGRES_PASSWORD}@postgres.ecs.local:5432/remediation
CELERY_BROKER_URL=redis://redis.ecs.local:6379/0
CELERY_RESULT_BACKEND=redis://redis.ecs.local:6379/1
API_UPSTREAM=http://api.ecs.local:8000
