GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_org/target_repo
DEVIN_API_KEY=your_devin_api_key_here
DEVIN_ORG_ID=your_devin_org_id_here
SCAN_INTERVAL_MINUTES=5
# Optional comma-separated allowed browser origins for read-only CORS (GET/HEAD/OPTIONS).
# Leave unset unless the SPA is served from a different origin than the API.
# CORS_ALLOW_ORIGINS=http://localhost:5173
# PostgreSQL connection string (matches the postgres service in docker-compose.yml).
# Leave unset to fall back to a local SQLite file (sqlite:///./remediation.db).
# Compose seeds the postgres container from POSTGRES_PASSWORD; keep it in sync with DATABASE_URL.
POSTGRES_PASSWORD=remediation
DATABASE_URL=postgresql+psycopg://remediation:remediation@postgres:5432/remediation
# Celery broker / result backend (matches the redis service in docker-compose.yml).
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Orchestrator implementation: "celery" (default). A future "temporal" option
# implements the same app.orchestrator.base.Orchestrator interface.
ORCHESTRATOR=celery
# Shared secret used to HMAC-verify GitHub webhook deliveries to POST /webhooks/github.
# Generate one with: python -c 'import secrets; print(secrets.token_hex(32))'
# Leave unset to disable the webhook endpoint (the reconciliation scan still runs).
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# Bearer token required by POST /ingest/semgrep (also stored as a repo secret for
# .github/workflows/semgrep.yml). Generate: python -c 'import secrets; print(secrets.token_hex(32))'
INGEST_TOKEN=your_ingest_token_here
# How often Celery Beat clones/updates the target repo and runs Semgrep.
SEMGREP_SCAN_INTERVAL_MINUTES=60
# Optional: Semgrep ruleset, checkout location, and cap on issues filed per run (0 = unlimited).
SEMGREP_CONFIG=p/default
SEMGREP_CHECKOUT_DIR=/tmp/remediation-checkout
SEMGREP_MAX_FINDINGS=0

# --- Phase 7: resilience, observability, shutdown ---------------------------
# Outbound HTTP (GitHub + Devin): connect/read timeouts in seconds and retry policy.
# Idempotent calls (GET/HEAD/OPTIONS/PUT/DELETE) retry timeouts, connection errors,
# 5xx and 429; non-idempotent POSTs (create_issue, create_session, post_comment)
# only retry 429. Backoff is exponential with full jitter, honouring Retry-After.
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_CAP_SECONDS=20
# Logging: "json" (one object per line with request_id/trace_id) or "text".
LOG_FORMAT=json
LOG_LEVEL=INFO
# OpenTelemetry: leave OTEL_EXPORTER_OTLP_ENDPOINT unset for no-op tracing.
# Point it at an OTLP/HTTP collector (e.g. http://otel-collector:4318) to export spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=devin-remediation-api
# Per-deployable service name for traces/logs (defaults: remediation-api / remediation-worker).
# SERVICE_NAME=remediation-api
# Tests only: run Celery tasks inline instead of through the broker.
# CELERY_TASK_ALWAYS_EAGER=0
# Celery task time limits (seconds): soft raises SoftTimeLimitExceeded, hard kills the task.
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=1200

# Production: do NOT ship this file. Source GITHUB_TOKEN, DEVIN_API_KEY, DEVIN_ORG_ID,
# GITHUB_WEBHOOK_SECRET, INGEST_TOKEN and POSTGRES_PASSWORD from a secret manager
# (Kubernetes Secret via External Secrets / Vault / AWS Secrets Manager / GCP Secret
# Manager) injected as environment variables. See README "Secrets management".
