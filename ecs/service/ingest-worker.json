{
  "cluster": "devin-remediation",
  "serviceName": "devin-remediation-ingest-worker",
  "taskDefinition": "devin-remediation-ingest-worker",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 100,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  },
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": [
        "subnet-REPLACE_PRIVATE_A",
        "subnet-REPLACE_PRIVATE_B"
      ],
      "securityGroups": [
        "sg-REPLACE_INGEST_WORKER"
      ],
      "assignPublicIp": "DISABLED"
    }
  },
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "ecs.local",
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/devin-remediation/ingest-worker-service-connect",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "ingest-worker-service-connect",
        "awslogs-create-group": "true"
      }
    }
  },
  "enableExecuteCommand": true,
  "propagateTags": "TASK_DEFINITION",
  "tags": [
    {
      "key": "app",
      "value": "devin-remediation"
    },
    {
      "key": "component",
      "value": "ingest-worker"
    }
  ]
}
